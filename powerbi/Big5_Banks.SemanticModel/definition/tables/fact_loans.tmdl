table fact_loans

	column loan_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: loan_id

	column customer_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: customer_id

	column bank_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: bank_id

	column loan_type
		dataType: string
		summarizeBy: none
		sourceColumn: loan_type

	column principal_cad
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: principal_cad

	column interest_rate_pct
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: interest_rate_pct

	column term_months
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: term_months

	column defaulted
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: defaulted

	partition fact_loans = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("D:\Work\projects\canada-big5-banks-powerbi-tableau\bi\fact_loans.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"loan_id", type text}, {"customer_id", type text}, {"bank_id", type text}, {"loan_type", type text}, {"principal_cad", type number}, {"interest_rate_pct", type number}, {"term_months", Int64.Type}, {"defaulted", Int64.Type}}, "en-US")
			in
				Typed
