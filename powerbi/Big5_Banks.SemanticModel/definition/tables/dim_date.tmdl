table dim_date
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		formatString: Long Date
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: string
		summarizeBy: none
		sourceColumn: quarter

	column month_num
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_num

	column month_name
		dataType: string
		summarizeBy: none
		sortByColumn: month_num
		sourceColumn: month_name

	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	partition dim_date = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("D:\Work\projects\canada-big5-banks-powerbi-tableau\bi\dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"date", type date}, {"year", Int64.Type}, {"quarter", type text}, {"month_num", Int64.Type}, {"month_name", type text}, {"year_month", type text}}, "en-US")
			in
				Typed
