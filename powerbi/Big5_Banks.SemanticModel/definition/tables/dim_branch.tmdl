table dim_branch

	column branch_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: branch_id

	column bank_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: bank_id

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column province
		dataType: string
		summarizeBy: none
		sourceColumn: province

	column opened_year
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: opened_year

	partition dim_branch = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("D:\Work\projects\canada-big5-banks-powerbi-tableau\bi\dim_branch.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"branch_id", type text}, {"bank_id", type text}, {"city", type text}, {"province", type text}, {"opened_year", Int64.Type}}, "en-US")
			in
				Typed
