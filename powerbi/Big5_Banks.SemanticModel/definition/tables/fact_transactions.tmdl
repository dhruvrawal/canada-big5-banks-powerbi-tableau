table fact_transactions

	column txn_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: txn_id

	column date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: date

	column account_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: account_id

	column customer_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: customer_id

	column bank_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: bank_id

	column branch_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: branch_id

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column channel
		dataType: string
		summarizeBy: none
		sourceColumn: channel

	column amount_cad
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: amount_cad

	column is_fraud
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: is_fraud

	partition fact_transactions = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("D:\Work\projects\canada-big5-banks-powerbi-tableau\bi\fact_transactions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"txn_id", type text}, {"date", type date}, {"account_id", type text}, {"customer_id", type text}, {"bank_id", type text}, {"branch_id", type text}, {"category", type text}, {"channel", type text}, {"amount_cad", type number}, {"is_fraud", Int64.Type}}, "en-US")
			in
				Typed
