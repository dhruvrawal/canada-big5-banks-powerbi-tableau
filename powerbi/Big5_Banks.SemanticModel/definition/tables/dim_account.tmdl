table dim_account

	column account_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: account_id

	column customer_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: customer_id

	column bank_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: bank_id

	column branch_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: branch_id

	column account_type
		dataType: string
		summarizeBy: none
		sourceColumn: account_type

	column balance
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: balance

	partition dim_account = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("D:\Work\projects\canada-big5-banks-powerbi-tableau\bi\dim_account.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"account_id", type text}, {"customer_id", type text}, {"bank_id", type text}, {"branch_id", type text}, {"account_type", type text}, {"balance", type number}}, "en-US")
			in
				Typed
