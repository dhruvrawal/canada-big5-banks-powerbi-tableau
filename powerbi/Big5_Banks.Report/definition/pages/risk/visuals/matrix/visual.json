{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "matrix",
  "position": {
    "x": 20,
    "y": 450,
    "z": 0,
    "height": 260,
    "width": 620,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_bank"
                    }
                  },
                  "Property": "bank_id"
                }
              },
              "queryRef": "dim_bank.bank_id",
              "nativeQueryRef": "bank_id"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_loans"
                    }
                  },
                  "Property": "loan_type"
                }
              },
              "queryRef": "fact_loans.loan_type",
              "nativeQueryRef": "loan_type"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Default Rate %"
                }
              },
              "queryRef": "_Measures.Default Rate %",
              "nativeQueryRef": "Default Rate %"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Default rate: bank x loan type (%)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}